rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Urlaubsplan: Jede angemeldete Person darf nur ihren eigenen Bereich lesen und schreiben.
    match /urlaubsplan/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
